# User service: runs as the logged-in user, never as root.
[Unit]
Description=ADG Power OS telemetry and control daemon
Documentation=file:///usr/share/doc/adg-power/deployment.md
After=dbus.socket
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/adg-powerd serve
Restart=on-failure
RestartSec=3
Nice=5
# Light hardening; the daemon needs D-Bus, sysfs/procfs reads and its state dir.
# pkexec (privileged helper) needs setuid, so NoNewPrivileges stays off.
ProtectSystem=strict
ReadWritePaths=%t %S %h/.local/state
PrivateTmp=yes
LockPersonality=yes
RestrictRealtime=yes
MemoryMax=64M

[Install]
WantedBy=default.target
